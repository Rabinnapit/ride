{
  "name": "RiderHQ — cycling analyzer, trainer, tracker",
  "short_name": "RiderHQ",
  "description": "Personal cycling analyzer, trainer, tracker and planner for Magene C706 and Zwift rides.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1b26",
  "theme_color": "#1b2733",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "fit",
          "accept": [
            "*/*",
            "application/octet-stream",
            "application/vnd.ant.fit",
            "application/fit",
            ".fit",
            ".FIT"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/octet-stream": [
          ".fit"
        ],
        "application/vnd.ant.fit": [
          ".fit"
        ]
      }
    }
  ],
  "categories": [
    "health",
    "fitness",
    "sports"
  ]
}